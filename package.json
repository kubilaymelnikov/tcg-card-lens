{
  "name": "tcg-card-lens",
  "version": "0.1.0",
  "private": true,
  "description": "Erkennt Magic- und Pokémon-Karten im Kamerabild bzw. in OBS-Quellen und blendet Cardmarket-Preise samt Verlauf ein.",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "start:lan": "node server/index.js --lan",
    "import:mtgjson": "node scripts/import-mtgjson.js",
    "test": "node --test server/*.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@techstark/opencv-js": "4.10.0-release.1",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "stream-json": "^1.9.1",
    "tesseract.js": "^5.1.1"
  }
}
